# Emulated linking on the f09 grid: every slot that has an emulator runs it.
#   meteorology   the JCM emulator P2@200 stepped IN THE LOOP (MET_SRC=emu,
#                 src/met/met_emu.py), free-running (no nudging, HL QBO drag,
#                 mass fix, u-fixer), regridded on the GPU to the f09 band and
#                 the CESM radiation column. One-way (ATM_FEEDBACK=0).
#   microphysics  the TOMAS emulator (cs_b student + tomas_jax.fast on the top
#                 0.3 % sulfur cells)
#   radiation     radem gen3 f09 (SW + LW aerosol-increment nets, Planck-damping net)
#   transport, settling: numerical (sl K=12; closed-form settling)
# The atmosphere bundle has one IC: run with --h0 8766 (1997-01-01T06).
# Compare with cesm_met_emulated (same aerosol/radiation emulators, CESM winds)
# to separate the meteorology's effect from the emulators' error.
#@submodule tomas-jax  models/tomas-jax  787c991e499342df2dc59c96470bd5f167537868
#@submodule jax-rrtmgp models/jax-rrtmgp 99d2d7174d2e6967c9c45e8f4bae22a4994d1c18 patch=patches/jax-rrtmgp-zenith.patch

MET_SRC=emu
ATM_BUNDLE=/data/AIDE-SAI-link-perf/atmos_port/bundle_P2s200
BC_SRC=clim
CLIM_FILE=inputs/bc_clim/bc_clim.npz
INIT_BIN=so4
ADV_VPOS=1

MICRO_ENGINE=emulator
EMU_STUDENT=/data/tomas-jax-output/emulator_h2so4_20261112/cs_b/final.pt
EMU_CKPT=/data/tomas-jax-output/emulator_growth_20261110/main_g03/stage_K24.pt
EMU_NORM=/data/tomas-jax-output/emulator_v1/foundation_mlp180/norm_stats.npz
# Routing (2026-11-23, 30-day A/B against the cesm_numerical runs; docs/EMULATED_LINKING.md):
# the plume (top 1 % of cells by sulfur) and the dense fine modes (top 4 % by number) to
# tomas_jax.fast, the adapter's accuracy defaults. The linked_emulator speed settings
# (0.3 % plume, no dense class, widened triage) let the control's number drift +79 % by day 116.
EMU_PHYS_TOP=0.01
EMU_PHYS_NUM=0.04
# no triage: the quiet step holds a cell's number fixed (no coagulation), which compounded
# into +10-25 % number at 20-60 hPa in the control by day 30; with the network on every
# cell that is 0-1 %
EMU_TRIAGE=0
# online per-(level, latitude band, bin) bias correction from a 1 % physics sample: halves
# the network's slow number bias at 3-10 hPa. Above ~10 hPa the network still drifts in number
# (control +3..+27 % at 1-8 hPa at day 30; AOD +0.04 %); EMU_PHYS_PTOP=10 removes it at ~6 s/step
EMU_ONLINE_CORR=0.01
# the physics cells (plume + dense + sample, ~6 % of the grid) in 4 chunks sorted by coagulation
# cost, as cesm_numerical's tomas_fast runs its own (50k-cell chunks, FAST_SORT=1): the stiff plume
# no longer sets the substep count of every routed cell. Day-119 plume: physics 5.5-6.2 -> 2.2-2.4 s
# on stiff steps; 16 steps N 3e-4, AOD 9e-5 relative to one chunk (integration level)
EMU_PHYS_CHUNKS=4
EMU_PHYS_EXACT=1
EMU_LOSTFIX=1
EMU_SDPA=1
SM_ATTN=tri

# ---- radiation: radem gen3 (f09) -- SW + LW aerosol-increment nets and the Planck-damping net,
# window_gq@3 trailing. gen3 = gen2's recipe retrained on gen2's P2-met labels PLUS labels on the
# AIDE-SAI CESM-met states (gen2 alone gave up to 98 K/day spikes on CESM meteorology:
# docs/EMULATED_LINKING.md). sha256 in RADEM_CKPT/SHA256SUMS.
RAD_ENGINE=radem
RADEM_CKPT=/mnt/nvme_stage/aide_sai_emulated/radem_gen3_f09
RADEM_MUFEAT=1
RAD_REF_INTERP_H=24
# no RRTMGP reference solve to cache
RAD_REF_CACHE=0
