# CESM numerical linking: CESM2 h1 meteorology, tomas_jax.fast microphysics, RRTMGP radiation
#
# Provenance: the 2-year runs fast_2yr_inj6_30NS and fast_2yr_ctrl (2026-11-18/19)
# were made with exactly these values and pins; this preset reproduces them
# bit-identically with ADV_SL_RHONORM=0 and the perf switches off:
#   ADV_SL_RHONORM=0 RAD_FAST=0 MICRO_WRAP_DEVICE=0 MAM4_BIN_DEVICE=0 ADV_SL_DEVICE_RESAMPLE=0 CKPT_ASYNC=0
# (pass them on the run_prod.py command line). Since PR #4 (dev, 2026-11-24) the default is
# ADV_SL_RHONORM=1, which removes a transport drift those runs carry (MANIFEST.md,
# "sl_lr level air mass"). The perf switches default on since 2026-11-23; with
# them on the result is within the code's own run-to-run GPU noise (48 h tests).
#
# Model slots: the checkout that fills each one, the commit it must be at, and
# the patch applied on top. run_prod.py refuses to start if they do not match.
#@submodule tomas-jax  models/tomas-jax  787c991e499342df2dc59c96470bd5f167537868
#@submodule jax-rrtmgp models/jax-rrtmgp 99d2d7174d2e6967c9c45e8f4bae22a4994d1c18 patch=patches/jax-rrtmgp-zenith.patch

# Meteorology: U, V, OMEGA, T hourly from the CESM h1 archive (CESM_DIR), f09 grid.
MET_SRC=cesm
# Every other boundary field (Q, O3, gases, MAM4 aerosol reservoirs, the
# radiation column) from the monthly CESM climatology on the f09 grid.
BC_SRC=clim
CLIM_FILE=inputs/bc_clim/bc_clim.npz
# MAM4 modes binned onto the 40 TOMAS bins by their so4 mass.
INIT_BIN=so4
# Vertical positivity limiter: required for a usable number field.
ADV_VPOS=1

# Output: the full 3-D state (all bins, gases, per-cell size statistics, TOA
# fields) to frames3d/step_<s>.npz every 21 steps = 5.25 days, which rotates the
# snapshot through the four UTC hours; ~33 GB per model year on the f09 grid.
# Output-only: the model state is unchanged with or without it. Without 3-D frames
# no time-mean map or column field can be made afterwards (the probe and zonal
# frames cannot stand in), so every preset writes them. FRAME3D=0 in the
# environment switches them off for a single run.
FRAME3D=1
FRAME3D_EVERY=21
