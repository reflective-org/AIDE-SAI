# CESM numerical linking with adaptive-sub-stepping microphysics: tomas-jax PR #49 make_step (heun_adaptive coag, adaptive gas sub-steps), RRTMGP
#
# Provenance: added 2026-11-25. Identical to cesm_numerical except the
# microphysics slot: tomas-jax dev's own make_step (MICRO_ENGINE=full) at the
# head of tomas-jax PR #49 (branch adaptive-coag, 0ba8f4b = dev 835ee24 + 8
# commits), instead of tomas_jax.fast on gpu-fast 787c991. No runs reproduced yet.
# Re-pin to the merge commit once PR #49 lands (a squash merge can orphan 0ba8f4b).
#
# Model slots: the checkout that fills each one, the commit it must be at, and
# the patch applied on top. run_prod.py refuses to start if they do not match.
#@submodule tomas-jax  models/tomas-jax-dev 0ba8f4be5a059550f65e0b4df297506a7b42f54b
#@submodule jax-rrtmgp models/jax-rrtmgp    99d2d7174d2e6967c9c45e8f4bae22a4994d1c18 patch=patches/jax-rrtmgp-zenith.patch

# Meteorology and boundary fields: as cesm_numerical (CESM2 h1 hourly
# U, V, OMEGA, T on f09; everything else from the monthly CESM climatology).
MET_SRC=cesm
BC_SRC=clim
CLIM_FILE=inputs/bc_clim/bc_clim.npz
INIT_BIN=so4
# Vertical positivity limiter: required for a usable number field.
ADV_VPOS=1

# Microphysics: tomas-jax dev make_step, the chain so2_chemistry -> nucleation
# -> coagulation -> condensation (coupling.py, MICRO=full), with the PR's
# recommended settings (tomas-jax docs/gas_substep.md, "Recommended settings";
# split_chemistry is NOT passed: with gas_substep='adaptive' it raises, the
# adaptive path always splits the chemistry).
MICRO_ENGINE=full
# heun_adaptive: error-controlled second-order coagulation, the lowest-error
# solver in the PR's comparison (L1 N 0.016 vs 0.019 for euler_adaptive).
MICRO_COAG=heun
# adaptive gas sub-steps at f = 0.1: passes every cell of the PR's 80-bin
# validation grid. Without them the nucleation gas clamp fires at >= 1 ppmv SO2
# (N > 3 nm up to 50x too high), i.e. in the injection plume.
MICRO_GAS_SUBSTEP=adaptive
MICRO_GAS_FRAC=0.1
# 360 s dev steps (60 per 6 h coupling step, one OH sample each): the outer step
# the PR benchmarks on GPU. Both the gas chain and the coagulation sub-step
# adaptively inside it.
MICRO_DT=360
# the PR's GPU runs at dt 360 s used 65536; ~41,000 are needed per 600 s at
# 217 K / 100 ppmv. Costs nothing unless needed; a binding cap aborts the run.
MICRO_GAS_MAX_SUBSTEPS=65536
# per-cell cap callbacks off (unrolled per cell under vmap: ~25x compile, ~90x
# step time); coupling.py reads the caps from the sub-step info instead and
# aborts on a hit (MICRO_CAP_ABORT=1, the default).
MICRO_CAP_WARNINGS=0
# reduced SO4/NH4/H2O species layout: round-off identical for this chain
# (tomas-jax tests/test_sulfate_only.py), 3 Mk columns instead of 44.
TOMAS_SPECIES=sulfate
# Cost only (results do not depend on chunk-mates): cells sorted by SO2
# production and run in 4096-cell chunks, the PR's GPU setup. In grid order with
# 50k chunks one sunlit injection cell holds a whole 50k chunk in lockstep.
MICRO_SORT=prod
CELL_CHUNK=4096

# Output: the full 3-D state to frames3d/ every 21 steps (5.25 days), as every
# preset; ~33 GB per model year on the f09 grid. FRAME3D=0 switches it off.
FRAME3D=1
FRAME3D_EVERY=21
