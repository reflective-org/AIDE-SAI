# JCM numerical linking: jcm-strat AL7h70 meteorology on the JCM grid, tomas_jax.fast microphysics, RRTMGP radiation
#
# Provenance: the 2-year run jcm_1yr_inj6_30NS (2026-11-18..20, extended to
# 2 years with RESUME) was made with exactly these values and pins; this
# preset reproduces it bit-identically with ADV_SL_RHONORM=0 and the perf switches off:
#   ADV_SL_RHONORM=0 RAD_FAST=0 MICRO_WRAP_DEVICE=0 MAM4_BIN_DEVICE=0 ADV_SL_DEVICE_RESAMPLE=0 CKPT_ASYNC=0
# (pass them on the run_prod.py command line). Since PR #4 (dev, 2026-11-24) the default is
# ADV_SL_RHONORM=1, which removes a transport drift those runs carry (MANIFEST.md,
# "sl_lr level air mass"). The perf switches default on since 2026-11-23; with
# them on the result is within the code's own run-to-run GPU noise (48 h tests).
# That run wrote no 3-D frames; the FRAME3D lines below were added afterwards
# and change only the output.
#
#@submodule tomas-jax  models/tomas-jax  787c991e499342df2dc59c96470bd5f167537868
#@submodule jax-rrtmgp models/jax-rrtmgp 99d2d7174d2e6967c9c45e8f4bae22a4994d1c18 patch=patches/jax-rrtmgp-zenith.patch

# Meteorology: U, V, OMEGA, T 6-hourly from a jcm-strat run directory, and the
# model grid with it (T63 Gaussian 96x192, JCM's native levels in the band).
# JCM_DIR is left at coupling.py's default, the AL7h70 chain:
#   /data/JCM_stripped/jcm-strat/runs/p31/p31_AL7h70
MET_SRC=jcm
# Everything else from the CESM climatology regridded onto the JCM grid
# (scripts/met/regrid_clim_to_grid.py); Q from it too (MET_Q=bc, the default:
# jcm-strat is dry).
BC_SRC=clim
CLIM_FILE=inputs/bc_clim/bc_clim_jcm.npz
INIT_BIN=so4
ADV_VPOS=1

# Output: the full 3-D state (all bins, gases, per-cell size statistics, TOA
# fields) to frames3d/step_<s>.npz every 21 steps = 5.25 days, which rotates the
# snapshot through the four UTC hours; ~22 GB per model year on the T63 grid.
# Output-only: the model state is unchanged with or without it. Without 3-D frames
# no time-mean map or column field can be made afterwards (the probe and zonal
# frames cannot stand in), so every preset writes them. FRAME3D=0 in the
# environment switches them off for a single run.
FRAME3D=1
FRAME3D_EVERY=21
