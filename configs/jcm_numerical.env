# JCM numerical linking: jcm-strat AL7h70 meteorology on the JCM grid, tomas_jax.fast microphysics, RRTMGP radiation
#
# Provenance: the 2-year run jcm_1yr_inj6_30NS (2026-11-18..20, extended to
# 2 years with RESUME) was made with exactly these values and pins; this
# preset reproduces it bit-identically when run with ADV_SL_RHONORM=0
# (--adv-sl-rhonorm 0). Since 2026-11-22 the default is ADV_SL_RHONORM=1, which
# removes a transport drift those runs carry (MANIFEST.md, "sl_lr level air mass").
#
#@submodule tomas-jax  models/tomas-jax  787c991e499342df2dc59c96470bd5f167537868
#@submodule jax-rrtmgp models/jax-rrtmgp 99d2d7174d2e6967c9c45e8f4bae22a4994d1c18 patch=patches/jax-rrtmgp-zenith.patch

# Meteorology: U, V, OMEGA, T 6-hourly from a jcm-strat run directory, and the
# model grid with it (T63 Gaussian 96x192, JCM's native levels in the band).
# JCM_DIR is left at coupling.py's default, the AL7h70 chain:
#   /data/JCM_stripped/jcm-strat/runs/p31/p31_AL7h70
MET_SRC=jcm
# Everything else from the CESM climatology regridded onto the JCM grid
# (scripts/met/regrid_clim_to_grid.py); Q from it too (MET_Q=bc, the default:
# jcm-strat is dry).
BC_SRC=clim
CLIM_FILE=inputs/bc_clim/bc_clim_jcm.npz
INIT_BIN=so4
ADV_VPOS=1
